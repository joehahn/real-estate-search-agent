# Copy to .env and fill in. .env is gitignored and read directly by Python:
# you never need to export these or pass them on the command line.

# ----- Data provider -----
# Which listing source to use: rentcast (default) or realtor.
DATA_PROVIDER=rentcast
# RentCast: free key (50 calls/month) at https://app.rentcast.io/app/api
RENTCAST_API_KEY=your_rentcast_key_here
# Realtor.com via RapidAPI (only if DATA_PROVIDER=realtor; see src/providers/realtor_rapidapi.py)
# RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_REALTOR_HOST=us-real-estate.p.rapidapi.com

# ----- Telegram bot (Level C: text the agent from your phone) -----
# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated chat ids allowed to run actions. Get yours by messaging the bot /whoami.
# The bot runs NOTHING for chat ids not listed here.
TELEGRAM_ALLOWED_CHAT_IDS=
# Permissions the bot grants `claude -p`. Empty by default so a leaked token is not code
# execution. Prefer a SCOPED allowlist over a blanket bypass:
# CLAUDE_ARGS=--allowedTools Bash(python*) Task Read Write WebSearch WebFetch
# (Use --permission-mode bypassPermissions only if you accept the risk above.)
# Allow open-ended chat (any text -> the agent). Off by default; it is the widest surface.
# BOT_ALLOW_FREEFORM=0
